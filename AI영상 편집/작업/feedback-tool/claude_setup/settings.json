      "Bash(python3 작업/feedback-tool/fb.py:*)",
      "Bash(python3 작업/feedback-tool/fb.py *)",
      "Bash(python3 작업/feedback-tool/fcpxml_edit.py:*)",
      "Bash(python3 작업/feedback-tool/fcpxml_edit.py *)",
      "Bash(python3 작업/feedback-tool/fcpxml.py:*)",
      "Bash(xmllint:*)",
      "Bash(ffprobe:*)"
